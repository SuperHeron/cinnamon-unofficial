SUMMARY="Python pam module supporting py3"
DESCRIPTION="
Python pam module supporting py3 (and py2) for Linux type systems (!windows)
"

LICENCES="MIT"
SLOT="0"
PLATFORMS="~amd64"
MYOPTIONS=""

RESTRICT="test" # No test found

